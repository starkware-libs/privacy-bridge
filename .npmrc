auto-install-peers=true

# @starkware-libs/* (privacy SDK) is published to GitHub Packages.
# Auth via the GITHUB_TOKEN env var at install time (no secret committed):
#   GITHUB_TOKEN=$(gh auth token) pnpm install
@starkware-libs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
