auto-install-peers=true

# @starkware-libs/* (privacy SDK) is published to GitHub Packages, which requires
# authentication even for public packages.
# pnpm does NOT expand ${ENV} in credential lines that come from a committed
# .npmrc (the token could leak to an attacker-controlled registry), so the auth
# token must live in a trusted, uncommitted config. Add it to your user-level
# ~/.npmrc once:
#   echo "//npm.pkg.github.com/:_authToken=YOUR_GITHUB_TOKEN" >> ~/.npmrc
# then a plain `pnpm install` works. CI writes the same line to ~/.npmrc.
#
# The token needs the read:packages scope. `gh auth token` supplies it only if the
# CLI was granted that scope — the default login is not, and the SDK tarball then
# 403s. Grant it with:
#   gh auth refresh -s read:packages
@starkware-libs:registry=https://npm.pkg.github.com
