auto-install-peers=true

# @starkware-libs/* (privacy SDK) is published to GitHub Packages.
# pnpm does NOT expand ${ENV} in credential lines that come from a committed
# .npmrc (the token could leak to an attacker-controlled registry), so the auth
# token must live in a trusted, uncommitted config. Add it to your user-level
# ~/.npmrc once:
#   npm config set "//npm.pkg.github.com/:_authToken" "$(gh auth token)"
# then a plain `pnpm install` works. CI writes the same line to ~/.npmrc.
@starkware-libs:registry=https://npm.pkg.github.com
